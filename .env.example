# Railway Traffic Optimizer (Chennai Division) - Environment Configuration Template

# Runtime state storage directory (persists runtime_simulation_state.json)
RAILWAY_RUNTIME_DIR=runtime

# Platform conflict detection toggle ('true' enables experimental station platform capacity conflicts)
# Default is false (only headway, line capacity, junction, and overtaking conflicts are enabled)
ENABLE_PLATFORM_CONFLICTS=false

# Allowed CORS origins for FastAPI backend (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend server host and port
API_HOST=0.0.0.0
API_PORT=8000
